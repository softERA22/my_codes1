public class Solution {

    public static void reverse(int[] A, int l, int r) {
        while (l < r) {
            int temp = A[l];
            A[l] = A[r];
            A[r] = temp;
            l++;
            r--;
        }
    }

    public int[] nextPermutation(int[] A) {
        int n = A.length;
        int di = -1;

        // Step 1: find di
        for (int i = n - 2; i >= 0; i--) {
            if (A[i] < A[i + 1]) {
                di = i;
                break;  
            }
        }

        // Step 2: find jg and swap
        if (di != -1) {
            int jg = di + 1;

            for (int i = di + 1; i < n; i++) {
                if (A[i] > A[di] && A[i] <= A[jg]) {
                    jg = i;
                }
            }

            
            int temp = A[di];
            A[di] = A[jg];
            A[jg] = temp;
        }

        // Step 3: reverse
        reverse(A, di + 1, n - 1);

        return A;   // ✅ return added
    }
}
